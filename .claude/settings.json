{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Edit",
      "Write",
      "Read",
      "Glob",
      "Grep",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch *)",
      "Bash(git add *)",
      "Bash(git commit *)"
    ],
    "ask": [
      "Edit(**/*.kicad_sch)",
      "Edit(**/*.kicad_pcb)",
      "Edit(**/*.kicad_pro)",
      "Bash(git push *)",
      "Bash(gh pr create *)",
      "Read(**/*.pdf)",
      "Bash(pdftotext *)"
    ],
    "deny": [
      "Read(~/.notebooklm/**)",
      "Read(**/documents/schematic/**/*.pdf)",
      "Read(**/documents/Schematics/**/*.pdf)",
      "Read(**/documents/manufacturing/**/*.pdf)",
      "Read(**/documents/Manufacturing/**/*.pdf)",
      "Edit(**/*.kicad_wks)",
      "Edit(**/templates/**)",
      "Edit(**/*.wrl)",
      "Bash(git push origin main*)",
      "Bash(git push origin master*)",
      "Bash(git push * HEAD:main*)",
      "Bash(git push * HEAD:master*)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(git clean -fd *)",
      "Bash(git merge *)",
      "Bash(gh pr merge *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/protect_kicad_v2.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
